generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                   String              @id @default(cuid())
  email                String              @unique
  passwordHash         String
  displayName          String?
  avatarUrl            String?
  role                 String              @default("user")
  emailVerified        Boolean             @default(false)
  emailVerifyToken     String?             @unique
  passwordResetToken   String?             @unique
  passwordResetExpires DateTime?
  isActive             Boolean             @default(true)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  sessions             Session[]
  oauthCredentials     OAuthCredential[]
  connectedAccounts    ConnectedAccount[]
  youtubeChannels      YouTubeChannel[]
  gaProperties         GoogleAnalyticsProperty[]
  youtubeVideos        YouTubeVideo[]
  analyticsMetrics     AnalyticsMetric[]
  indexedRecords       IndexedRecord[]
  indexerJobs          IndexingJob[]
  crawlerJobs          CrawlerJob[]
  analyticalReports    AnalyticalReport[]
  notifications        Notification[]
  auditLogs            AuditLog[]
  searchHistory        SearchHistory[]

  @@map("users")
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  token        String   @default(cuid())
  refreshToken String?  @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  ipAddress    String?
  userAgent    String?
  isActive     Boolean  @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model ConnectedAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String?
  displayName       String?
  email             String?
  profileImageUrl   String?
  status            String   @default("disconnected")
  lastSyncAt        DateTime?
  errorMessage      String?
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  oauthCredential OAuthCredential?

  @@unique([userId, provider, providerAccountId])
  @@index([provider])
  @@map("connected_accounts")
}

model OAuthCredential {
  id                 String      @id @default(cuid())
  connectedAccountId String      @unique
  userId             String?
  accessToken        String
  refreshToken       String
  idToken            String?
  scope              String?
  scopes             String?
  tokenType          String      @default("Bearer")
  expiresIn          Int?
  expiresAt          DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  connectedAccount   ConnectedAccount @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)
  user               User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([connectedAccountId])
  @@map("oauth_credentials")
}

model YouTubeChannel {
  id                  String      @id @default(cuid())
  connectedAccountId  String?
  userId              String?
  channelId           String      @unique
  title               String?
  description         String?
  customUrl           String?
  thumbnailUrl        String?
  viewCount           BigInt?
  subscriberCount     BigInt?
  subscriberHidden    Boolean?
  hiddenSubscriberCount Boolean?
  channelUrl          String?
  country             String?
  language            String?
  totalViews          BigInt?
  videoCount          Int?
  publishedAt         DateTime?
  lastFetchedAt       DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  videos YouTubeVideo[]

  @@map("youtube_channels")
}

model YouTubeChannelMetric {
  id               String    @id @default(cuid())
  channelId        String
  date             DateTime
  views            Int?
  watchTimeMinutes Float?
  subscribersGained Int?
  subscribersLost  Int?
  likes            Int?
  comments         Int?
  shares           Int?
  estimatedRevenue Float?
  impressions      Int?
  ctr              Float?
  createdAt        DateTime  @default(now())

  @@unique([channelId, date])
  @@map("youtube_channel_metrics")
}

model YouTubeVideo {
  id                   String        @id @default(cuid())
  userId               String?
  channelId            String
  videoId              String        @unique
  title                String?
  description          String?
  thumbnailUrl         String?
  channelTitle         String?
  publishedAt          DateTime?
  videoUrl             String?
  duration             String?
  privacyStatus        String?
  categoryId           String?
  tags                 String?
  viewCount            BigInt?
  likeCount            BigInt?
  commentCount         BigInt?
  favoriteCount        BigInt?
  definition           String?
  caption              Boolean?
  licensedContent      Boolean?
  liveBroadcasting     Boolean?
  localizations        String?
  defaultLanguage      String?
  defaultAudioLanguage String?
  contentDetails       String?
  status               String?
  lastFetchedAt        DateTime?
  lastSyncedAt         DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel YouTubeChannel @relation(fields: [channelId], references: [channelId], onDelete: Cascade)
  metrics AnalyticsMetric[]

  @@index([videoId])
  @@index([publishedAt])
  @@map("youtube_videos")
}

model GoogleAnalyticsProperty {
  id                 String    @id @default(cuid())
  userId             String?
  connectedAccountId String?
  propertyId         String    @unique
  accountId          String?
  name               String?
  displayName        String?
  parentAccountId    String?
  webPropertyId      String?
  industryVertical   String?
  timezone           String?
  currency           String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ga_properties")
}

model GoogleAnalyticsMetric {
  id             String    @id @default(cuid())
  propertyId     String
  date           DateTime
  sessions       Int?
  users          Int?
  newUsers       Int?
  pageViews      Int?
  bounceRate     Float?
  engagementRate Float?
  conversions    Int?
  createdAt      DateTime  @default(now())

  @@unique([propertyId, date])
  @@map("ga_metrics")
}

model AnalyticsMetric {
  id         String      @id @default(cuid())
  userId     String?
  sourceType String
  entityId   String?
  videoId    String?
  propertyId String?
  metrics    String
  dimensions String?
  date       DateTime
  value      Float?
  unit       String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  video YouTubeVideo? @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([date])
  @@index([sourceType])
  @@map("analytics_metrics")
}

model IndexedRecord {
  id            String      @id @default(cuid())
  userId        String?
  sourceType    String
  entityId      String?
  entityType    String?
  title         String?
  description   String?
  data          String
  metadata      String?
  confidence    Float?
  indexedAt     DateTime    @default(now())
  nextIndexAt   DateTime?
  status        String      @default("PENDING")
  error         String?

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sourceType])
  @@map("indexed_records")
}

model IndexingJob {
  id              String      @id @default(cuid())
  userId          String?
  type            String?
  jobType         String?
  sourceType      String?
  entityId        String?
  status          String      @default("PENDING")
  progress        Int         @default(0)
  progressPercent Int         @default(0)
  currentStep     String?
  totalItems      Int?
  processed       Int         @default(0)
  failed          Int         @default(0)
  error           String?
  errorMessage    String?
  logJson         String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("indexing_jobs")
}

model CrawlerJob {
  id              String     @id @default(cuid())
  userId          String?
  sourceType      String?
  entityId        String?
  jobType         String?
  sources         String?
  status          String      @default("PENDING")
  progress        Int        @default(0)
  progressPercent Int        @default(0)
  currentStep     String?
  totalItems      Int?
  processed       Int        @default(0)
  itemsProcessed  Int        @default(0)
  itemsUpdated    Int        @default(0)
  itemsFailed     Int        @default(0)
  failed          Int        @default(0)
  error           String?
  lastError       String?
  logJson         String?
  retryCount      Int        @default(0)
  maxRetries      Int        @default(3)
  scheduledAt     DateTime?
  startedAt       DateTime?
  pausedAt        DateTime?
  completedAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("crawler_jobs")
}

model AnalyticalReport {
  id            String      @id @default(cuid())
  userId        String?
  title         String      @default("Report")
  name          String?
  reportType    String      @default("general")
  type          String?
  source        String?
  dateFrom      DateTime?
  dateTo        DateTime?
  data          String      @default("{}")
  dataJson      String      @default("{}")
  summary       String?
  visualization String?
  exportedAt    DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("analytical_reports")
}

model Notification {
  id          String      @id @default(cuid())
  userId      String?
  type        String
  title       String?
  message     String?
  data        String?
  metadata    String?
  isRead      Boolean     @default(false)
  priority    String      @default("normal")
  createdAt   DateTime    @default(now())
  readAt      DateTime?

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model AuditLog {
  id          String      @id @default(cuid())
  userId      String?
  action      String
  resource    String?
  resourceId  String?
  ipAddress   String?
  userAgent   String?
  metadata    String?
  success     Boolean     @default(true)
  createdAt   DateTime    @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model SearchHistory {
  id             String   @id @default(cuid())
  userId         String?
  queryText      String
  parsedIntent   String?
  resultSummary  String?
  hasResults     Boolean
  resultDataJson String?
  responseTimeMs Int?
  createdAt      DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("search_history")
}
