# Environment Configuration Template
# Copy this file to .env and fill in your real values

NODE_ENV=development
PORT=5000
DATABASE_URL="file:./pmav-database.db"
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=""

# Just use these obvious-fake placeholders
JWT_ACCESS_SECRET="FAKE_ACCESS_TOKEN_NOT_REAL_12345"
JWT_REFRESH_SECRET="FAKE_REFRESH_TOKEN_NOT_REAL_12345"
ENCRYPTION_KEY="FAKE_ENCRYPTION_KEY_NOT_REAL_1234567890ABCDEF"

# OAuth placeholders (GitHub won't flag these)
YOUTUBE_DATA_CLIENT_ID="GH_FAKE_CLIENT_ID_YOUTUBE"
YOUTUBE_DATA_CLIENT_SECRET="FAKE_CLIENT_SECRET_YOUTUBE"
YOUTUBE_DATA_REDIRECT_URI="http://localhost:5000/api/v1/integrations/youtube-data/callback"

YOUTUBE_ANALYTICS_CLIENT_ID="FAKE_ANALYTICS_CLIENT_ID"
YOUTUBE_ANALYTICS_CLIENT_SECRET="FAKE_ANALYTICS_CLIENT_SECRET"
YOUTUBE_ANALYTICS_REDIRECT_URI="http://localhost:5000/api/v1/integrations/youtube-analytics/callback"

YOUTUBE_REPORTING_CLIENT_ID="FAKE_REPORTING_CLIENT_ID"
YOUTUBE_REPORTING_CLIENT_SECRET="FAKE_REPORTING_CLIENT_SECRET"
YOUTUBE_REPORTING_REDIRECT_URI="http://localhost:5000/api/v1/integrations/youtube-reporting/callback"

GOOGLE_CLIENT_ID="FAKE_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="FAKE_GOOGLE_CLIENT_SECRET"
GOOGLE_ADSENSE_REDIRECT_URI="http://localhost:5000/api/v1/integrations/google-adsense/callback"
GOOGLE_ANALYTICS_REDIRECT_URI="http://localhost:5000/api/v1/integrations/google-analytics/callback"
GOOGLE_SEARCH_CONSOLE_REDIRECT_URI="http://localhost:5000/api/v1/integrations/google-search-console/callback"

OPENAI_API_KEY=
GEMINI_API_KEY=

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

SOCKET_IO_CORS_ORIGIN="http://localhost:3000"
