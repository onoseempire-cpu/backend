# Environment Configuration
# Copy this file to .env and fill in your values

# Application
NODE_ENV=development
PORT=5000

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/pmav_analytics?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=""

# JWT Authentication
JWT_ACCESS_SECRET="your-access-token-secret-change-in-production"
JWT_REFRESH_SECRET="your-refresh-token-secret-change-in-production"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# OAuth 2.0 - YouTube
YOUTUBE_CLIENT_ID="121502338820-q91d774cgi208u8r1bsde3sivvna0p93.apps.googleusercontent.com"
