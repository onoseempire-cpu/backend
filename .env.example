# ==============================================================================
# PROGRAM MAKER ANALYTICAL VIEWER - BACKEND ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your real values.
# NEVER commit .env to source control.
# ==============================================================================

# ── SERVER ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
API_VERSION=v1

# ── DATABASE (SQLite - local file, no server needed) ─────────────────────────
# The database file will be created automatically in the project root.
DATABASE_URL="file:./pmav-database.db"

# ── JWT SECRETS ───────────────────────────────────────────────────────────────
# Generate strong random secrets: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=REPLACE_WITH_STRONG_SECRET_64_CHARS_MIN
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_STRONG_SECRET_64_CHARS_MIN
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── ENCRYPTION KEY (for OAuth token storage) ──────────────────────────────────
# Must be exactly 32 characters for AES-256
ENCRYPTION_KEY=REPLACE_WITH_EXACTLY_32_CHAR_SECRET

# ── CORS / FRONTEND ──────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
ELECTRON_ORIGIN=file://

# ── EMAIL (optional - for verification emails) ───────────────────────────────
# Use Gmail, Mailtrap, or any SMTP provider
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM="PMAV System <noreply@pmav.local>"

# ==============================================================================
# GOOGLE / YOUTUBE OAUTH CREDENTIALS
# ==============================================================================

# ── YOUTUBE DATA API v3 ───────────────────────────────────────────────────────
YOUTUBE_DATA_CLIENT_ID=1uhjiqiwiuw33wjws
YOUTUBE_DATA_CLIENT_SECRET=Ghwqjwuwiqjjwjjqqw
YOUTUBE_DATA_REDIRECT_URI=http://localhost:5000/api/v1/integrations/youtube-data/callback

# ── YOUTUBE ANALYTICS API ─────────────────────────────────────────────────────
YOUTUBE_ANALYTICS_CLIENT_ID=1210nreaimcsmn.apps.googleusercontent.com
YOUTUBE_ANALYTICS_CLIENT_SECRET=Gpooqwwqqpqqa
YOUTUBE_ANALYTICS_REDIRECT_URI=http://localhost:5000/api/v1/integrations/youtube-analytics/callback

# ── YOUTUBE REPORTING API ─────────────────────────────────────────────────────
YOUTUBE_REPORTING_CLIENT_ID=usercontent.com
YOUTUBE_REPORTING_CLIENT_SECRET=
YOUTUBE_REPORTING_REDIRECT_URI=http://localhost:5000/api/v1/integrations/youtube-reporting/callback

# ── GOOGLE ADSENSE + ANALYTICS + SEARCH CONSOLE ───────────────────────────────
# Single OAuth app used for AdSense, Google Analytics 4, and Search Console
GOOGLE_CLIENT_ID=m
GOOGLE_CLIENT_SECRET=G
GOOGLE_ADSENSE_REDIRECT_URI=http://localhost:5000/api/v1/integrations/adsense/callback
GOOGLE_ANALYTICS_REDIRECT_URI=http://localhost:5000/api/v1/integrations/google-analytics/callback
GOOGLE_SEARCH_CONSOLE_REDIRECT_URI=http://localhost:5000/api/v1/integrations/search-console/callback

# ── OPTIONAL LLM (leave blank to use rule-based NLP only) ─────────────────────
OPENAI_API_KEY=
GEMINI_API_KEY=

# ── RATE LIMITING ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5

# ── LOGGING ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FILE=./logs/pmav-backend.log
