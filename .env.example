# Environment Configuration Template
# Copy this file to .env and fill in your real values

# Application
NODE_ENV=development
PORT=5000

# Database
DATABASE_URL="file:./pmav-database.db"

# Redis
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=""

# JWT Authentication
JWT_ACCESS_SECRET="your-access-token-secret-min-32-chars"
JWT_REFRESH_SECRET="your-refresh-token-secret-min-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Encryption Key (exactly 32 chars for AES-256)
ENCRYPTION_KEY="your-32-char-encryption-key-here"

# OAuth 2.0 - YouTube Data API v3
YOUTUBE_DATA_CLIENT_ID="your-youtube-data-client-id"
YOUTUBE_DATA_CLIENT_SECRET="your-youtube-data-client-secret"
YOUTUBE_DATA_REDIRECT_URI="http://localhost:5000/api/v1/integrations/youtube-data/callback"

# OAuth 2.0 - YouTube Analytics API
YOUTUBE_ANALYTICS_CLIENT_ID="your-youtube-analytics-client-id"
YOUTUBE_ANALYTICS_CLIENT_SECRET="your-youtube-analytics-client-secret"
YOUTUBE_ANALYTICS_REDIRECT_URI="http://localhost:5000/api/v1/integrations/youtube-analytics/callback"

# OAuth 2.0 - YouTube Reporting API
YOUTUBE_REPORTING_CLIENT_ID="your-youtube-reporting-client-id"
YOUTUBE_REPORTING_CLIENT_SECRET="your-youtube-reporting-client-secret"
YOUTUBE_REPORTING_REDIRECT_URI="http://localhost:5000/api/v1/integrations/youtube-reporting/callback"

# OAuth 2.0 - Google (AdSense, Analytics, Search Console)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_ADSENSE_REDIRECT_URI="http://localhost:5000/api/v1/integrations/google-adsense/callback"
GOOGLE_ANALYTICS_REDIRECT_URI="http://localhost:5000/api/v1/integrations/google-analytics/callback"
GOOGLE_SEARCH_CONSOLE_REDIRECT_URI="http://localhost:5000/api/v1/integrations/google-search-console/callback"

# Optional LLM
OPENAI_API_KEY=
GEMINI_API_KEY=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Socket.IO
SOCKET_IO_CORS_ORIGIN="http://localhost:3000"
